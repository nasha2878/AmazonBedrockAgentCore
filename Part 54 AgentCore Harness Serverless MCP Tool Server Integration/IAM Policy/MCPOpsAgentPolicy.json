{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "BedrockModelAndProfileInference",
            "Effect": "Allow",
            "Action": [
                "bedrock:InvokeModel",
                "bedrock:InvokeModelWithResponseStream"
            ],
            "Resource": [
                "arn:aws:bedrock:*:*:foundation-model/anthropic.claude-*",
                "arn:aws:bedrock:*:*:inference-profile/us.anthropic.claude-*"
            ]
        },
        {
            "Sid": "AgentCoreManagementGatewayAndRuntime",
            "Effect": "Allow",
            "Action": [
                "bedrock-agentcore:*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "CloudFormationAndCDKDeployment",
            "Effect": "Allow",
            "Action": [
                "cloudformation:*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "SecureIAMRoleOrchestration",
            "Effect": "Allow",
            "Action": [
                "iam:CreateRole",
                "iam:DeleteRole",
                "iam:GetRole",
                "iam:AttachRolePolicy",
                "iam:DetachRolePolicy",
                "iam:PutRolePolicy",
                "iam:DeleteRolePolicy",
                "iam:CreatePolicy",
                "iam:DeletePolicy",
                "iam:GetPolicy",
                "iam:GetPolicyVersion"
            ],
            "Resource": [
                "arn:aws:iam::*:role/cdk-*",
                "arn:aws:iam::*:role/AgentCore-*",
                "arn:aws:iam::*:role/*myMemOpsAgentProj*",
                "arn:aws:iam::*:policy/AgentCore-*",
                "arn:aws:iam::*:policy/*myMemOpsAgentProj*"
            ]
        },
        {
            "Sid": "SecurePassRoleToAgentCore",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": [
                        "://amazonaws.com",
                        "://amazonaws.com"
                    ]
                }
            }
        },
        {
            "Sid": "SecureCDKBootstrapping",
            "Effect": "Allow",
            "Action": [
                "s3:CreateBucket",
                "s3:PutBucketVersioning",
                "s3:PutBucketPublicAccessBlock",
                "s3:PutEncryptionConfiguration",
                "s3:GetBucketLocation",
                "s3:ListBucket",
                "ecr:CreateRepository",
                "ecr:DescribeRepositories"
            ],
            "Resource": "*"
        }
    ]
}
